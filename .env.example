# ── Telegram Monitor (ki_telegram_monitor.py) ──────────────────────────────────
# Token bot Telegram — buat dari @BotFather
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
# Chat ID lu — bisa dapat dari @userinfobot (kirim /start ke bot itu)
TELEGRAM_CHAT_ID=replace-with-your-chat-id
# Interval poll status bot (detik, default 60)
KIBOT_MONITOR_POLL_SEC=60
# Alert kalau PnL harian turun di bawah ini (%)
KIBOT_ALERT_LOSS_PCT=-1.0
# Alert kalau PnL harian naik di atas ini (%)
KIBOT_ALERT_WIN_PCT=1.5
