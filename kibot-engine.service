ExecStartPre=-/usr/bin/pkill -f gradle.*:apps:mac-engine:run
ExecStartPre=-/usr/bin/pkill -f /home/ubuntu/KiBot/apps/mac-engine/build/libs/mac-engine-0.1.0-all.jar
ExecStartPre=-/usr/bin/pkill -f /home/ubuntu/mac-engine-0.1.0-all.jar
ExecStartPre=-/usr/bin/pkill -f /home/ubuntu/KiBot/server/mac-engine-all.jar
ExecStartPre=-/usr/bin/fuser -k 8787/tcp
ExecStart=/bin/bash -lc '/usr/bin/java $JAVA_OPTS -jar /home/ubuntu/KiBot/server/mac-engine-all.jar'
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
SuccessExitStatus=143
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kibot-engine

[Install]
WantedBy=multi-user.target
