After=network.target
Wants=network.target

[Service]
Type=simple
User=ubuntu
PermissionsStartOnly=true
WorkingDirectory=/home/ubuntu/KiBot
EnvironmentFile=-/home/ubuntu/KiBot/.env.server
Environment=SUPABASE_URL=https://txdvrhkxkylnlxnkpmfl.supabase.co
Environment=SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InR4ZHZyaGt4a3lsbmx4bmtwbWZsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzM4ODgwNTIsImV4cCI6MjA4OTQ2NDA1Mn0.Tz_8veCdatdTMpxwbSDmSCxvBTX50O3bYc1koFmUiKw
Environment=DEVICE_ID=oracle-main
Environment=DEVICE_DISPLAY_NAME="Oracle Cloud Server"
Environment=DEVICE_ROLE=PRIMARY
Environment=MAC_ENGINE_BIND_HOST=0.0.0.0
Environment=MAC_ENGINE_PORT=8787
Environment=BOT_ENABLE_LIVE_EXECUTION=true
Environment=BOT_POLL_INTERVAL_MS=3000
Environment=BOT_EXCHANGE_PING_REFRESH_INTERVAL_MS=3000
Environment=BOT_BALANCE_REFRESH_INTERVAL_MS=4000
Environment=BOT_OPEN_ORDERS_REFRESH_INTERVAL_MS=4000
Environment=BOT_DAILY_RISK_REFRESH_INTERVAL_MS=15000
Environment=BOT_DEVICES_REFRESH_INTERVAL_MS=30000
Environment=BOT_COMMANDS_REFRESH_INTERVAL_MS=3000
Environment=BOT_WEEKLY_SUMMARY_REFRESH_INTERVAL_MS=60000
Environment=BOT_RECENT_ORDERS_REFRESH_INTERVAL_MS=6000
Environment=BOT_RECENT_FILLS_REFRESH_INTERVAL_MS=6000
Environment=BOT_ANALYSIS_PUBLISH_INTERVAL_MS=20000
Environment=BOT_STRATEGY_METRICS_PUBLISH_INTERVAL_MS=180000
Environment=GEMINI_SUPPORT_ENABLED=true
Environment=GEMINI_SUPPORT_MODEL=gemini-2.0-flash-lite
Environment=GEMINI_SUPPORT_MAX_CANDIDATES=8
Environment=GEMINI_SUPPORT_MIN_INTERVAL_MINUTES=60
Environment=GEMINI_SUPPORT_TIMEOUT_MS=10000
Environment=GEMINI_SUPPORT_HOURLY_REQUEST_BUDGET=6
