Environment=BOT_EXCHANGE_PING_REFRESH_INTERVAL_MS=8000
Environment=BOT_BALANCE_REFRESH_INTERVAL_MS=12000
Environment=BOT_OPEN_ORDERS_REFRESH_INTERVAL_MS=12000
Environment=BOT_DAILY_RISK_REFRESH_INTERVAL_MS=15000
