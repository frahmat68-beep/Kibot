Environment=SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InR4ZHZyaGt4a3lsbmx4bmtwbWZsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzM4ODgwNTIsImV4cCI6MjA4OTQ2NDA1Mn0.Tz_8veCdatdTMpxwbSDmSCxvBTX50O3bYc1koFmUiKw
