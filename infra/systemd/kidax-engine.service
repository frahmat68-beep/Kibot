[Unit]
Description=KiDax Indodax Trading Engine
After=network.target
Wants=network.target
StartLimitIntervalSec=300
StartLimitBurst=5
StartLimitAction=none

[Service]
Type=simple
User=ubuntu
PermissionsStartOnly=true
WorkingDirectory=/home/ubuntu/KiDax
EnvironmentFile=-/home/ubuntu/KiDax/.env.kidax
Environment=BOT_ID=kidax
Environment=BOT_PROFILE_KEY=kidax
Environment=KIBOT_EXCHANGE_KIND=INDODAX
Environment=DEVICE_ID=kidax-oracle-sg
Environment=DEVICE_DISPLAY_NAME="KiDax Oracle Singapore"
Environment=DEVICE_ROLE=PRIMARY
Environment=KIBOT_RUNTIME_ROOT=/home/ubuntu/KiDax
Environment=KIBOT_SERVICE_NAME=kidax-engine
Environment=MAC_ENGINE_ENABLE_LAN_ADVERTISE=false
Environment=KIBOT_LOCAL_POSITION_STATE_ENABLED=true
Environment=KIBOT_LEAD_LAG_UDP_ENABLED=true
Environment=KIBOT_LEAD_LAG_UDP_HEARTBEAT_ENABLED=true
Environment=KIBOT_LEAD_LAG_UDP_HEARTBEAT_INTERVAL_MS=1000
Environment=KIBOT_LEAD_LAG_UDP_HEARTBEAT_TIMEOUT_MS=5000
Environment=KIBOT_HIVE_EXPECTED_BOT_IDS=kinance,kibot
Environment="JAVA_OPTS=-XX:+UseSerialGC -Xms96m -Xmx256m -Dkotlinx.coroutines.scheduler.core.pool.size=2 -Dkotlinx.coroutines.scheduler.max.pool.size=3 -Dfile.encoding=UTF-8"
ExecStart=/bin/bash -lc '/usr/bin/java $JAVA_OPTS -jar /home/ubuntu/KiDax/server/mac-engine-all.jar'
Restart=on-failure
RestartSec=5
OOMPolicy=kill
TimeoutStartSec=120
TimeoutStopSec=20
KillSignal=SIGTERM
SuccessExitStatus=143
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kidax-engine

[Install]
WantedBy=multi-user.target
