[Unit]
Description=KiBot Manager UDP Veto Daemon
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5
StartLimitAction=none

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KiBot
EnvironmentFile=-/home/ubuntu/KiBot/.env.server
EnvironmentFile=-/home/ubuntu/KiBot/.env.kibot
EnvironmentFile=-/home/ubuntu/KiBot/.env.kibot_manager
Environment=PYTHONUNBUFFERED=1
Environment=KIBOT_MANAGER_STATE_DIR=/home/ubuntu/KiBot/state
Environment=KIBOT_MANAGER_PROVIDER_STATE_FILE=/home/ubuntu/KiBot/state/ai_provider_state.json
Environment=KIBOT_MANAGER_RUNTIME_NOTE_FILE=/home/ubuntu/KiBot/state/runtime_note.json
Environment=KIBOT_MANAGER_HEARTBEAT_INTERVAL_SEC=1.0
Environment=KIBOT_AI_PROVIDER_ORDER=openrouter,groq,gemini,nvidia,cohere,jina
Environment=KIBOT_AI_REQUEST_TIMEOUT_SEC=15
Environment=KIBOT_AI_COORDINATOR_TIMEOUT_SEC=30
Environment=KIBOT_AI_PROVIDER_DEFAULT_COOLDOWN_SEC=300
Environment=KIBOT_AI_PROVIDER_NETWORK_COOLDOWN_SEC=120
Environment=KIBOT_AI_PROVIDER_RATE_LIMIT_COOLDOWN_SEC=300
Environment=KIBOT_AI_PROVIDER_EMPTY_COOLDOWN_SEC=60
Environment=KIBOT_AI_PROVIDER_OLLAMA_COOLDOWN_SEC=120
Environment=GROQ_MODEL=llama-3.1-8b-instant
Environment=OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
Environment=COHERE_MODEL=command-a-03-2025
Environment=GEMINI_MODEL=gemini-2.0-flash-lite
Environment=KIBOT_OLLAMA_FAST_MODEL=qwen3:0.6b
Environment=KIBOT_OLLAMA_MODEL=qwen3:1.7b
Environment=KIBOT_OLLAMA_DEEP_MODEL=qwen3:8b
Environment=KIBOT_OLLAMA_FAST_TIMEOUT_SEC=30
Environment=KIBOT_OLLAMA_DEFAULT_TIMEOUT_SEC=40
Environment=KIBOT_OLLAMA_DEEP_TIMEOUT_SEC=180
Environment=KIBOT_OLLAMA_FAST_KEEP_ALIVE=45s
Environment=KIBOT_OLLAMA_KEEP_ALIVE=90s
Environment=KIBOT_OLLAMA_DEEP_KEEP_ALIVE=5m
Environment=KIBOT_OLLAMA_FAST_NUM_CTX=2048
Environment=KIBOT_OLLAMA_DEFAULT_NUM_CTX=3072
Environment=KIBOT_OLLAMA_DEEP_NUM_CTX=6144
Environment=KIBOT_OLLAMA_FAST_NUM_PREDICT=180
Environment=KIBOT_OLLAMA_DEFAULT_NUM_PREDICT=260
Environment=KIBOT_OLLAMA_DEEP_NUM_PREDICT=640
Environment=KIBOT_AI_APPROVAL_MIN_SCORE=0.58
Environment=KIBOT_AI_APPROVAL_MIN_EXPECTED_NET_PCT=0.0025
Environment=KIBOT_AI_APPROVAL_INSTANT_MIN_SCORE=0.52
Environment=KIBOT_AI_APPROVAL_INSTANT_MIN_EXPECTED_NET_PCT=0.0010
Environment=KIBOT_STALE_SIGNAL_MS=800
Environment=KIBOT_INDODAX_TAKER_FEE=0.003
Environment=KIBOT_MAKER_FEE=0.0015
Environment=KIBOT_ROUND_TRIP_TAKER_COST=0.006
Environment=KIBOT_ROUND_TRIP_MAKER_COST=0.003
Environment=KIBOT_SLIPPAGE_BUFFER=0.002
Environment=KIBOT_MIN_GROSS_PROFIT_TARGET=0.011
Environment=KIBOT_PARTIAL_TP_TRIGGER=0.012
Environment=KIBOT_PARTIAL_TP_SIZE=0.40
Environment=KIBOT_TRAILING_STOP_MIN_PCT=0.015
Environment=KIBOT_POST_MORTEM_BLACKLIST_ENABLED=true
Environment=KIBOT_POST_MORTEM_BLACKLIST_MINUTES=45
Environment=KIBOT_POST_MORTEM_BLACKLIST_NET_LOSS_IDR=500
Environment=KIBOT_POST_MORTEM_BLACKLIST_PNL_PCT=-1.0
Environment=KIBOT_DAILY_SUMMARY_ENABLED=true
Environment=KIBOT_MANAGER_DAILY_SUMMARY_FILE=/home/ubuntu/KiBot/state/daily_summary.json
ExecStart=/usr/bin/python3 -u /home/ubuntu/KiBot/scripts/kibot_manager.py
Restart=always
RestartSec=5
OOMPolicy=kill
MemoryMax=160M
Nice=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kibot-manager

[Install]
WantedBy=multi-user.target
