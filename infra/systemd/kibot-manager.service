[Unit]
Description=KiBot Manager UDP Veto Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KiBot
EnvironmentFile=-/home/ubuntu/KiBot/.env.server
EnvironmentFile=-/home/ubuntu/KiBot/.env.kibot_manager
Environment=PYTHONUNBUFFERED=1
Environment=KIBOT_MANAGER_STATE_DIR=/home/ubuntu/KiBot/state
Environment=KIBOT_MANAGER_PROVIDER_STATE_FILE=/home/ubuntu/KiBot/state/ai_provider_state.json
Environment=KIBOT_MANAGER_RUNTIME_NOTE_FILE=/home/ubuntu/KiBot/state/runtime_note.json
Environment=KIBOT_MANAGER_HEARTBEAT_INTERVAL_SEC=0.10
Environment=KIBOT_AI_PROVIDER_ORDER=groq,openrouter,cohere,gemini
Environment=KIBOT_AI_REQUEST_TIMEOUT_SEC=12
Environment=KIBOT_AI_PROVIDER_DEFAULT_COOLDOWN_SEC=600
Environment=KIBOT_AI_PROVIDER_NETWORK_COOLDOWN_SEC=180
Environment=KIBOT_AI_PROVIDER_RATE_LIMIT_COOLDOWN_SEC=3600
Environment=KIBOT_AI_PROVIDER_EMPTY_COOLDOWN_SEC=120
Environment=GROQ_MODEL=llama-3.1-8b-instant
Environment=OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
Environment=COHERE_MODEL=command-r
Environment=GEMINI_MODEL=gemini-2.0-flash-lite
Environment=KIBOT_AI_APPROVAL_MIN_SCORE=0.62
Environment=KIBOT_AI_APPROVAL_MIN_EXPECTED_NET_PCT=0.18
Environment=KIBOT_AI_APPROVAL_INSTANT_MIN_SCORE=0.48
Environment=KIBOT_AI_APPROVAL_INSTANT_MIN_EXPECTED_NET_PCT=-0.02
Environment=KIBOT_POST_MORTEM_BLACKLIST_ENABLED=true
Environment=KIBOT_POST_MORTEM_BLACKLIST_MINUTES=30
Environment=KIBOT_POST_MORTEM_BLACKLIST_NET_LOSS_IDR=500
Environment=KIBOT_POST_MORTEM_BLACKLIST_PNL_PCT=-1.0
Environment=KIBOT_DAILY_SUMMARY_ENABLED=true
Environment=KIBOT_MANAGER_DAILY_SUMMARY_FILE=/home/ubuntu/KiBot/state/daily_summary.json
Environment=KIDAX_UDP_HOST=213.35.118.26
Environment=KINANCE_UDP_HOST=152.69.218.198
ExecStart=/usr/bin/python3 -u /home/ubuntu/KiBot/scripts/kibot_manager.py
Restart=always
RestartSec=2
MemoryMax=192M
Nice=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kibot-manager

[Install]
WantedBy=multi-user.target
