[Unit]
Description=KiCryp Manager UDP Veto Daemon
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5
StartLimitAction=none

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KiCryp
EnvironmentFile=-/home/ubuntu/KiCryp/.env.server
EnvironmentFile=-/home/ubuntu/KiCryp/.env.kicryp_manager
Environment=PYTHONUNBUFFERED=1
Environment=KICRYP_MANAGER_STATE_DIR=/home/ubuntu/KiCryp/state
Environment=KICRYP_MANAGER_PROVIDER_STATE_FILE=/home/ubuntu/KiCryp/state/ai_provider_state.json
Environment=KICRYP_MANAGER_RUNTIME_NOTE_FILE=/home/ubuntu/KiCryp/state/runtime_note.json
Environment=KICRYP_MANAGER_HEARTBEAT_INTERVAL_SEC=1.0
Environment=KICRYP_AI_PROVIDER_ORDER=groq,openrouter,cohere,gemini
Environment=KICRYP_AI_REQUEST_TIMEOUT_SEC=8
Environment=KICRYP_AI_PROVIDER_DEFAULT_COOLDOWN_SEC=900
Environment=KICRYP_AI_PROVIDER_NETWORK_COOLDOWN_SEC=180
Environment=KICRYP_AI_PROVIDER_RATE_LIMIT_COOLDOWN_SEC=3600
Environment=KICRYP_AI_PROVIDER_EMPTY_COOLDOWN_SEC=180
Environment=GROQ_MODEL=llama-3.1-8b-instant
Environment=OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
Environment=COHERE_MODEL=command-r
Environment=GEMINI_MODEL=gemini-2.0-flash-lite
Environment=KICRYP_AI_APPROVAL_MIN_SCORE=0.62
Environment=KICRYP_AI_APPROVAL_MIN_EXPECTED_NET_PCT=0.0018
Environment=KICRYP_AI_APPROVAL_INSTANT_MIN_SCORE=0.62
Environment=KICRYP_AI_APPROVAL_INSTANT_MIN_EXPECTED_NET_PCT=0.0018
Environment=KICRYP_INDODAX_TAKER_FEE=0.003
Environment=KICRYP_MAKER_FEE=0.0015
Environment=KICRYP_ROUND_TRIP_TAKER_COST=0.006
Environment=KICRYP_ROUND_TRIP_MAKER_COST=0.003
Environment=KICRYP_SLIPPAGE_BUFFER=0.002
Environment=KICRYP_MIN_GROSS_PROFIT_TARGET=0.011
Environment=KICRYP_PARTIAL_TP_TRIGGER=0.012
Environment=KICRYP_PARTIAL_TP_SIZE=0.40
Environment=KICRYP_TRAILING_STOP_MIN_PCT=0.015
Environment=KICRYP_POST_MORTEM_BLACKLIST_ENABLED=true
Environment=KICRYP_POST_MORTEM_BLACKLIST_MINUTES=45
Environment=KICRYP_POST_MORTEM_BLACKLIST_NET_LOSS_IDR=500
Environment=KICRYP_POST_MORTEM_BLACKLIST_PNL_PCT=-1.0
Environment=KICRYP_DAILY_SUMMARY_ENABLED=true
Environment=KICRYP_MANAGER_DAILY_SUMMARY_FILE=/home/ubuntu/KiCryp/state/daily_summary.json
Environment=KIDAX_UDP_HOST=213.35.118.26
Environment=KINANCE_UDP_HOST=152.69.218.198
ExecStart=/usr/bin/python3 -u /home/ubuntu/KiCryp/scripts/kicryp_manager.py
Restart=on-failure
RestartSec=5
OOMPolicy=kill
MemoryMax=160M
Nice=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kicryp-manager

[Install]
WantedBy=multi-user.target
