[Unit]
Description=KiBot Polymarket Tunnel to Batam Executor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
ExecStart=/usr/bin/ssh -NT -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=yes -i /home/ubuntu/KiBot/keys/ssh-key-batam-active.pem -L 127.0.0.1:11600:127.0.0.1:11600 ubuntu@168.110.201.228
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kibot-polymarket-tunnel

[Install]
WantedBy=multi-user.target
