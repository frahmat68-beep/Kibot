[Unit]
Description=KiBot Telegram Monitor & Ops Chat
After=network-online.target kibot-manager.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KiBot
EnvironmentFile=-/home/ubuntu/KiBot/.env.server
EnvironmentFile=-/home/ubuntu/KiBot/.env.kibot
EnvironmentFile=-/home/ubuntu/KiBot/.env.kibot_manager
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u /home/ubuntu/KiBot/scripts/ki_telegram_monitor.py
Restart=always
RestartSec=5
MemoryMax=120M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ki-telegram-monitor

[Install]
WantedBy=multi-user.target
