[Unit]
Description=Lazarus Ampere Hunter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ampere-hunt
Environment=PATH=/home/ubuntu/bin:/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/bin/bash -lc 'cd /home/ubuntu/ampere-hunt && ./lazarus_ampere.sh >> /home/ubuntu/logs/lazarus_ampere.log 2>&1'
Restart=on-failure
RestartSec=20

[Install]
WantedBy=multi-user.target
