[Unit]
Description=KiBot Ollama Gateway
After=network-online.target ollama.service
Wants=network-online.target
Requires=ollama.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KiBot
EnvironmentFile=-/home/ubuntu/KiBot/.env.server
EnvironmentFile=-/home/ubuntu/KiBot/.env.kibot
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u /home/ubuntu/KiBot/scripts/kibot_ollama_gateway.py
Restart=always
RestartSec=5
MemoryMax=96M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kibot-ollama-gateway

[Install]
WantedBy=multi-user.target
