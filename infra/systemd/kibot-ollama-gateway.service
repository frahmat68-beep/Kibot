[Unit]
Description=KiBot Ollama Gateway
After=network-online.target ollama.service
Wants=network-online.target
Requires=ollama.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KiBot
EnvironmentFile=-/home/ubuntu/KiBot/.env.server
EnvironmentFile=-/home/ubuntu/KiBot/.env.kibot
Environment=PYTHONUNBUFFERED=1
Environment=KIBOT_OLLAMA_GATEWAY_TIMEOUT_SEC=60
Environment=KIBOT_OLLAMA_GATEWAY_FORCE_MODEL=qwen3:0.6b
Environment=KIBOT_OLLAMA_GATEWAY_MODEL_ALIASES=qwen3:1.7b=qwen3:0.6b,qwen3:4b=qwen3:0.6b
Environment=KIBOT_OLLAMA_GATEWAY_FAST_MAX_CTX=2048
Environment=KIBOT_OLLAMA_GATEWAY_FAST_MAX_PREDICT=220
Environment=KIBOT_OLLAMA_GATEWAY_FAST_MAX_INPUT_CHARS=7000
Environment=KIBOT_OLLAMA_GATEWAY_DEFAULT_MAX_INPUT_CHARS=12000
Environment=KIBOT_OLLAMA_GATEWAY_FAST_KEEP_ALIVE=4m
ExecStart=/usr/bin/python3 -u /home/ubuntu/KiBot/scripts/kibot_ollama_gateway.py
Restart=always
RestartSec=5
MemoryMax=128M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kibot-ollama-gateway

[Install]
WantedBy=multi-user.target
