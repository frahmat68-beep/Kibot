[Unit]
Description=KiBot Commander Engine
After=network.target
Wants=network.target
StartLimitIntervalSec=300
StartLimitBurst=10
StartLimitAction=none

[Service]
Type=simple
User=ubuntu
PermissionsStartOnly=true
WorkingDirectory=/home/ubuntu/KiBot
EnvironmentFile=-/home/ubuntu/KiBot/.env.kibot
Environment=BOT_ID=kibot
Environment=BOT_PROFILE_KEY=kibot
Environment=KIBOT_EXCHANGE_KIND=BINANCE_SPOT
Environment=DEVICE_ID=kibot-oracle-sg
Environment=DEVICE_DISPLAY_NAME="KiBot Oracle Singapore"
Environment=DEVICE_ROLE=PRIMARY
Environment=KIBOT_RUNTIME_ROOT=/home/ubuntu/KiBot
Environment=KIBOT_SERVICE_NAME=kibot-engine
Environment=KIBOT_DASHBOARD_PORT=8788
Environment=KIBOT_ENV_FILE=/home/ubuntu/KiBot/.env.kibot
Environment=MAC_ENGINE_BIND_HOST=0.0.0.0
Environment=MAC_ENGINE_PORT=8788
Environment=MAC_ENGINE_ENABLE_LAN_ADVERTISE=false
Environment=KIBOT_LOCAL_POSITION_STATE_ENABLED=true
Environment=KIBOT_LEAD_LAG_UDP_ENABLED=true
Environment=KIBOT_LEAD_LAG_UDP_HEARTBEAT_ENABLED=true
Environment=KIBOT_LEAD_LAG_UDP_HEARTBEAT_INTERVAL_MS=1000
Environment=KIBOT_LEAD_LAG_UDP_HEARTBEAT_TIMEOUT_MS=5000
Environment=KIBOT_HIVE_EXPECTED_BOT_IDS=kinance,kidax
Environment="JAVA_OPTS=-XX:+UseSerialGC -Xms96m -Xmx256m -Dkotlinx.coroutines.scheduler.core.pool.size=2 -Dkotlinx.coroutines.scheduler.max.pool.size=3 -Dfile.encoding=UTF-8"
ExecStart=/bin/bash -lc '/usr/bin/java $JAVA_OPTS -jar /home/ubuntu/KiBot/server/mac-engine-all.jar'
Restart=on-failure
RestartSec=5
OOMPolicy=kill
LimitNOFILE=65535
TimeoutStartSec=120
TimeoutStopSec=60
KillSignal=SIGTERM
SuccessExitStatus=143
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kibot-engine

[Install]
WantedBy=multi-user.target
