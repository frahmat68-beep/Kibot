[Unit]
Description=KiBot Local early pump detector (Phase 2)
After=network.target

[Service]
Type=simple
User=kiki
WorkingDirectory=/home/ubuntu/kibot
ExecStart=/usr/bin/python3 core/kibot_local_signal.py
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=kibot-local-scanner

[Install]
WantedBy=multi-user.target
