[Unit]
Description=Kinance Binance Spot Trading Engine
After=network.target
Wants=network.target
StartLimitIntervalSec=300
StartLimitBurst=10
StartLimitAction=none

[Service]
Type=simple
User=ubuntu
PermissionsStartOnly=true
WorkingDirectory=/home/ubuntu/Kinance
EnvironmentFile=-/home/ubuntu/Kinance/.env.kinance
Environment=BOT_ID=kinance
Environment=BOT_PROFILE_KEY=kinance
Environment=KIBOT_EXCHANGE_KIND=BINANCE_SPOT
Environment=DEVICE_ID=kinance-oracle-sg
Environment=DEVICE_DISPLAY_NAME="Kinance Oracle Singapore"
Environment=DEVICE_ROLE=PRIMARY
Environment=KIBOT_RUNTIME_ROOT=/home/ubuntu/Kinance
Environment=KIBOT_SERVICE_NAME=kinance-engine
Environment=MAC_ENGINE_ENABLE_LAN_ADVERTISE=false
Environment=KIBOT_LOCAL_POSITION_STATE_ENABLED=true
Environment=KIBOT_LEAD_LAG_UDP_ENABLED=true
Environment=KIBOT_LEAD_LAG_UDP_HEARTBEAT_ENABLED=true
Environment=KIBOT_LEAD_LAG_UDP_HEARTBEAT_INTERVAL_MS=1000
Environment=KIBOT_LEAD_LAG_UDP_HEARTBEAT_TIMEOUT_MS=5000
Environment=KIBOT_HIVE_EXPECTED_BOT_IDS=kidax,kibot
Environment="JAVA_OPTS=-XX:+UseSerialGC -Xms96m -Xmx256m -Dkotlinx.coroutines.scheduler.core.pool.size=2 -Dkotlinx.coroutines.scheduler.max.pool.size=3 -Dfile.encoding=UTF-8"
ExecStart=/bin/bash -lc '/usr/bin/java $JAVA_OPTS -jar /home/ubuntu/Kinance/server/mac-engine-all.jar'
Restart=on-failure
RestartSec=5
OOMPolicy=kill
LimitNOFILE=65535
TimeoutStartSec=120
TimeoutStopSec=60
KillSignal=SIGTERM
SuccessExitStatus=143
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kinance-engine

[Install]
WantedBy=multi-user.target
