[Unit]
Description=KiBot Security Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/KiBot
ExecStart=/usr/bin/python3 scripts/kibot_security.py
Restart=on-failure
RestartSec=60
MemoryMax=30M

[Install]
WantedBy=multi-user.target
