[Unit]
Description=Kinance Binance Spot Trading Engine
After=network.target
Wants=network.target

[Service]
Type=simple
User=ubuntu
PermissionsStartOnly=true
WorkingDirectory=/home/ubuntu/Kinance
EnvironmentFile=-/home/ubuntu/Kinance/.env.kinance
Environment=BOT_ID=kinance
Environment=BOT_PROFILE_KEY=kinance
Environment=KICRYP_EXCHANGE_KIND=BINANCE_SPOT
Environment=DEVICE_ID=kinance-oracle-sg
Environment=DEVICE_DISPLAY_NAME="Kinance Oracle Singapore"
Environment=DEVICE_ROLE=PRIMARY
Environment=KICRYP_RUNTIME_ROOT=/home/ubuntu/Kinance
Environment=KICRYP_SERVICE_NAME=kinance-engine
Environment=KICRYP_DASHBOARD_PORT=8788
Environment=KICRYP_ENV_FILE=/home/ubuntu/Kinance/.env.kinance
Environment=MAC_ENGINE_BIND_HOST=0.0.0.0
Environment=MAC_ENGINE_PORT=8788
Environment=MAC_ENGINE_ENABLE_LAN_ADVERTISE=false
Environment=KICRYP_LOCAL_POSITION_STATE_ENABLED=true
Environment=KICRYP_LEAD_LAG_UDP_ENABLED=true
Environment=KICRYP_LEAD_LAG_UDP_HEARTBEAT_ENABLED=true
Environment=KICRYP_LEAD_LAG_UDP_HEARTBEAT_INTERVAL_MS=100
Environment=KICRYP_LEAD_LAG_UDP_HEARTBEAT_TIMEOUT_MS=500
Environment=KICRYP_HIVE_EXPECTED_BOT_IDS=main,kicryp
Environment="JAVA_OPTS=-XX:+UseSerialGC -Xms128m -Xmx300m -Dkotlinx.coroutines.scheduler.core.pool.size=2 -Dkotlinx.coroutines.scheduler.max.pool.size=3 -Dfile.encoding=UTF-8"
ExecStartPre=-/usr/bin/pkill -f /home/ubuntu/Kinance/server/mac-engine-all.jar
ExecStartPre=-/usr/bin/fuser -k 8788/tcp
ExecStart=/bin/bash -lc '/usr/bin/java $JAVA_OPTS -jar /home/ubuntu/Kinance/server/mac-engine-all.jar'
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
SuccessExitStatus=143
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kinance-engine

[Install]
WantedBy=multi-user.target
